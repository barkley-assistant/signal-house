{
  "name": "signal-house",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "Local operator dashboard for AI coding agents — Bun-native rewrite",
  "scripts": {
    "dev": "bun run scripts/dev.ts",
    "build:web": "bun run scripts/build-web.ts",
    "build": "bun run build:web && bun build src/server.ts --target=bun --production --outdir=dist",
    "compile": "bun run build:web && bun build --compile src/server.ts --outfile=dist/signal-house",
    "start": "bun run dist/server.js",
    "typecheck": "bunx tsc --noEmit",
    "lint": "bunx eslint .",
    "test": "bun test tests/",
    "test:e2e": "bunx playwright test",
    "test:watch": "bun test --watch",
    "check": "bun run typecheck && bun run lint && bun run test && bun run build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/react": "^16.3.2",
    "@types/bun": "^1.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@typescript-eslint/eslint-plugin": "8",
    "@typescript-eslint/parser": "8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "happy-dom": "^20.11.1",
    "typescript": "5.9"
  },
  "dependencies": {
    "echarts": "6.1.0",
    "framer-motion": "12.43.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zustand": "5.0.14"
  }
}
