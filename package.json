{
  "name": "signal-house",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "Local operator dashboard for AI coding agents — Bun-native rewrite",
  "scripts": {
    "dev": "bun run scripts/dev.ts",
    "build": "bun build src/server.ts --target=bun --production --outdir=dist",
    "compile": "bun build --compile src/server.ts --outfile=dist/signal-house",
    "start": "bun run dist/server.js",
    "typecheck": "bunx tsc --noEmit",
    "lint": "bunx eslint .",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "check": "bun run typecheck && bun run lint && bun test && bun run build"
  },
  "dependencies": {
    "@ark-ui/react": "^5.37.2",
    "echarts": "^6.1.0",
    "framer-motion": "^12.43.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "happy-dom": "^20.11.1",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.65.0"
  }
}
