# Signal House local configuration example.
# Copy to .env for local development, or to ~/.config/signal-house/.env
# for the daemon-style runtime described in README.md.

# Optional HTTP basic access protection. Leave password empty to disable.
SECRET_HOUSE_ACCESS_USERNAME=signal-house
SECRET_HOUSE_ACCESS_PASSWORD=

# GitHub API access. Token is required for issues, PRs, Actions, and checks.
SECRET_HOUSE_GITHUB_TOKEN=
SECRET_HOUSE_GITHUB_OWNER=
SECRET_HOUSE_GITHUB_REPO=

# Local git inputs. Use explicit repos, discovery roots, or both.
# Comma-separated paths are supported.
SECRET_HOUSE_GIT_REPOS=
SECRET_HOUSE_PROJECT_ROOTS=
SECRET_HOUSE_GIT_REPO_GLOBS=*
SECRET_HOUSE_GIT_DISCOVERY_MAX_DEPTH=3
SECRET_HOUSE_GIT_EXCLUDE=node_modules,dist,.next,.nuxt,.output

# AI coding agent session usage collection window (days) for hermes + opencode.
SECRET_HOUSE_SESSIONS_PERIOD_DAYS=90

# Hermes Agent token usage collection.
# Path to Hermes Agent's state.db (default: ~/.hermes/state.db).
SECRET_HOUSE_HERMES_DB_PATH=

# OpenCode usage collection.
# Path to OpenCode's sqlite db (default: ~/.local/share/opencode/opencode.db).
SECRET_HOUSE_OPENCODE_DB_PATH=

# Background refresh loop.
SECRET_HOUSE_POLLER_ENABLED=false
SECRET_HOUSE_POLL_INTERVAL_SECONDS=300
SECRET_HOUSE_POLL_STARTUP_DELAY_SECONDS=5
SECRET_HOUSE_RUN_ON_STARTUP=true

# Collector/orchestrator defaults.
SECRET_HOUSE_COLLECT_CONCURRENCY=3
SECRET_HOUSE_COLLECT_LOOKBACK_DAYS=90
SECRET_HOUSE_STALE_THRESHOLD_DAYS=14

# Minimum seconds between GitHub collector passes. The poll loop still runs
# at SECRET_HOUSE_POLL_INTERVAL_SECONDS for the fast local sources (git,
# hermes, opencode); GitHub is only re-collected when this interval has
# elapsed since its last successful capture. Clamped to >= 60.
SECRET_HOUSE_GITHUB_INTERVAL_SECONDS=600

# Dashboard/runtime freshness and retention.
SECRET_HOUSE_STALE_THRESHOLD_MINUTES=15
SECRET_HOUSE_RETENTION_SNAPSHOTS_DAYS=30
SECRET_HOUSE_RETENTION_DAILY_METRICS_DAYS=90

# Attention queue: include issues and PRs from private GitHub repos.
# When false (default), private-repo items are hidden from the Attention Queue
# only; dashboard stats and other views are unaffected.
SECRET_HOUSE_SHOW_PRIVATE_REPO_ITEMS=false

# Cost estimation. When true (default), every cost figure on the dashboard is
# computed at read time from tokens × model rates — litellm's public pricing
# table first (refreshed daily into a local cache), then any rates configured
# in your OpenCode config. Nothing estimated is persisted to the database;
# flipping this to false shows upstream-reported values on the next refresh.
# See docs/operations.md §Cost estimation for details.
SIGNAL_HOUSE_ESTIMATE_COSTS=true

# Host resource metrics (mem / swap / cpu percentages) read from local PCP
# pmlogger archives. Off by default: the chart stays hidden, no archives are
# read. Turn on only where pmlogger is installed and logging this host
# (check: ls /var/log/pcp/pmlogger/$(hostname)/). See docs/operations.md
# §Host metrics for details.
SIGNAL_HOUSE_HOST_METRICS_ENABLED=false

# SQLite database directory. Defaults to .data when unset.
DB_DIR=.data

# Server bind address and port. Defaults: 0.0.0.0:8999 in production,
# 0.0.0.0:3000 in dev (the dev wrapper picks a free port).
HOST=0.0.0.0
PORT=8999

# Refresh lock staleness in milliseconds. A lock older than this is
# considered abandoned and can be stolen by the next refresh.
SECRET_HOUSE_REFRESH_LOCK_STALE_MS=600000
